#include <windows.h>

// The program's icon, shared by both executables so the overlay and the
// manager are recognisably the same thing in the taskbar.
//
// Resource id 1: Windows takes the lowest-numbered icon in a binary as the
// application icon, and the shell reads it straight out of the file, so nothing
// has to load it at runtime for it to appear on the window and in Explorer.
//
// assets/icon.ico is generated by tools/make_icon.py rather than drawn by hand,
// so it can be rebuilt when the interface's palette moves.
1 ICON "../assets/icon.ico"
